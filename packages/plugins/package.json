{
  "name": "@native-dates/plugins",
  "version": "1.0.0",
  "description": "Opt-in subpath plugins for native-dates",
  "author": "Jack Lukic",
  "license": "ISC",
  "homepage": "https://nativedates.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Semantic-Org/Native-Dates.git",
    "directory": "packages/plugins"
  },
  "bugs": {
    "url": "https://github.com/Semantic-Org/Native-Dates/issues"
  },
  "publishConfig": {
    "access": "public"
  },
