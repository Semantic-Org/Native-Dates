{
  "name": "native-dates",
  "version": "0.0.6",
  "title": "Native Dates",
  "description": "Natural-language dates, times, durations, and ranges built on the browser's Temporal and Intl APIs",
  "author": "Jack Lukic",
  "repository": "https://github.com/Semantic-Org/Native-Dates",
  "homepage": "https://nativedates.dev",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./helpers/*": "./src/helpers/*.js"
  },
  "bin": {
    "native-dates": "bin/native-dates.js"
  },
  "files": [
    "src",
    "types",
    "bin",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    ".",
    "packages/*",
    "docs"
  ],
  "scripts": {
    "docs": "npm -w docs run dev",
    "test": "vitest",
    "errors": "node tools/gates/errors.js --all",
    "comments": "node tools/gates/comments.js --all",
    "ai": "node tools/gates/ai.js",
    "ai:index": "node tools/gates/decisions-index.js --write",
    "size": "node tools/gates/budget.js",
    "types": "tsc --noEmit && tsc --noEmit --module preserve --moduleResolution bundler",
    "check": "npm test && npm run ai && npm run size",
    "format": "npx dprint fmt",
    "prepare": "simple-git-hooks",
    "prepack": "node tools/skills.js pack",
    "postpack": "node tools/skills.js clean",
    "setup:demo": "node tools/setup-demo.js",
    "setup": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "acorn": "^8.19.0",
    "dprint": "^0.65.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bash tools/hooks/pre-commit",
    "commit-msg": "bash tools/hooks/commit-msg \"$1\""
  }
}
