{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "types/**/*.d.ts",
    "packages/core/*.d.ts",
    "packages/plugins/types/*.d.ts",
    "packages/polyfill/*.d.ts",
    "test/**/*.ts"
  ]
}
