#!/usr/bin/env bash

MSG_FILE="$1"

if grep -qi 'Co-Authored-By:' "$MSG_FILE"; then
  echo 'Error: Commit messages must not contain Co-Authored-By lines.'
  exit 1
fi

if grep -qiE 'Claude-Session:|claude\.ai/code/session' "$MSG_FILE"; then
  echo 'Error: Commit messages must not contain Claude-Session lines or session links.'
  exit 1
fi

# the subject is the whole message, since a body is where generated prose gets in.
# git's own merge and revert messages keep the body git writes for them
if tail -n +2 "$MSG_FILE" | sed '/^# -* >8 -*$/,$d' | grep -v '^#' | grep -q '[^[:space:]]' \
  && ! head -1 "$MSG_FILE" | grep -qE '^(Merge |Revert ")'; then
  echo 'Error: Commit messages are a subject line only. Remove the body.'
  exit 1
fi

if [ -n "$CLAUDECODE" ]; then
  subject=$(head -1 "$MSG_FILE")
  vocab='Feat|Bug|Docs|Chore|Harness|Test|Perf|Refactor|Build|Bench|BREAKING'
  pattern="^(${vocab})(/(${vocab}))?(\\([a-z][a-z0-9-]*\\))?: [A-Z].*[^.]\$"
  if ! echo "$subject" | grep -qE "$pattern"; then
    cat <<EOF
Error: Subject must match 'Category: Description' format.
Got:      $subject
Expected: Feat: Add city alias table to zones plugin
          Feat(plugins): Add loose date parser        (with package scope)
          Feat/Bug: Support negative offsets in zone  (compound, rare)
Vocabulary: Feat, Bug, Docs, Chore, Harness, Test, Perf, Refactor, Build, Bench, BREAKING
Both category and description capitalized. No trailing period.
EOF
    exit 1
  fi
fi
