---
import { AGENT_PROMPT, AGENT_QUOTES, JEV_DECISION } from '../../data/agent-quotes.js';
import { t } from '../../lib/i18n.js';

const locale = Astro.currentLocale;

const SOURCE_MARK = {
  anthropic:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.304 3.541h-3.672l6.696 16.918H24Zm-10.608 0L0 20.459h3.744l1.37-3.553h7.005l1.369 3.553h3.744L10.536 3.541Zm-.371 10.223L8.616 7.82l2.291 5.945Z"/></svg>',
  openai:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.282 9.821a6 6 0 0 0-.516-4.91a6.05 6.05 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a6 6 0 0 0-3.998 2.9a6.05 6.05 0 0 0 .743 7.097a5.98 5.98 0 0 0 .51 4.911a6.05 6.05 0 0 0 6.515 2.9A6 6 0 0 0 13.26 24a6.06 6.06 0 0 0 5.772-4.206a6 6 0 0 0 3.997-2.9a6.06 6.06 0 0 0-.747-7.073M13.26 22.43a4.48 4.48 0 0 1-2.876-1.04l.141-.081l4.779-2.758a.8.8 0 0 0 .392-.681v-6.737l2.02 1.168a.07.07 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494M3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085l4.783 2.759a.77.77 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646M2.34 7.896a4.5 4.5 0 0 1 2.366-1.973V11.6a.77.77 0 0 0 .388.677l5.815 3.354l-2.02 1.168a.08.08 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.08.08 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667m2.01-3.023l-.141-.085l-4.774-2.782a.78.78 0 0 0-.785 0L9.409 9.23V6.897a.07.07 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.8.8 0 0 0-.393.681zm1.097-2.365l2.602-1.5l2.607 1.5v2.999l-2.597 1.5l-2.607-1.5Z"/></svg>',
  google:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81"/></svg>',
  qwen:
    '<svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M19.713 2.825h-5.907c0-.251-.066-.503-.196-.728L12.819.728A1.46 1.46 0 0 0 11.559 0h-1.58c-.52 0-1 .275-1.26.728l-2.42 4.19a1.45 1.45 0 0 0 0 1.453l.791 1.37c.26.448.74.727 1.26.727h11.36c.52 0 1-.275 1.26-.728l.79-1.37a1.45 1.45 0 0 0 0-1.451l-.79-1.37a1.46 1.46 0 0 0-1.26-.728zM.195 9.905l2.951 5.115a1.46 1.46 0 0 0-.531.531l-.791 1.37a1.45 1.45 0 0 0 0 1.452l.79 1.37c.26.448.74.727 1.26.727h4.84c.52 0 1-.275 1.26-.728l.79-1.37a1.45 1.45 0 0 0 0-1.451L5.086 7.083a1.46 1.46 0 0 0-1.26-.728h-1.58c-.52 0-1 .276-1.26.728l-.79 1.37a1.45 1.45 0 0 0 0 1.452m15.888 13.367 2.951-5.115c.217.125.469.196.728.196h1.582c.52 0 1-.275 1.26-.728l.79-1.37a1.45 1.45 0 0 0 0-1.451l-2.42-4.191a1.46 1.46 0 0 0-1.259-.728h-1.582c-.52 0-1 .276-1.259.728l-5.678 9.838a1.45 1.45 0 0 0 0 1.452l.79 1.37c.26.448.74.727 1.26.727h1.582c.52 0 1-.275 1.26-.728z"/></svg>',
  minimax:
    '<svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M16.278 2c1.156 0 2.093.927 2.093 2.07v12.501a.74.74 0 00.744.709.74.74 0 00.743-.709V9.099a2.06 2.06 0 012.071-2.049A2.06 2.06 0 0124 9.1v6.561a.649.649 0 01-.652.645.649.649 0 01-.653-.645V9.1a.762.762 0 00-.766-.758.762.762 0 00-.766.758v7.472a2.037 2.037 0 01-2.048 2.026 2.037 2.037 0 01-2.048-2.026v-12.5a.785.785 0 00-.788-.753.785.785 0 00-.789.752l-.001 15.904A2.037 2.037 0 0113.441 22a2.037 2.037 0 01-2.048-2.026V18.04c0-.356.292-.645.652-.645.36 0 .652.289.652.645v1.934c0 .263.142.506.372.638.23.131.514.131.744 0a.734.734 0 00.372-.638V4.07c0-1.143.937-2.07 2.093-2.07zm-5.674 0c1.156 0 2.093.927 2.093 2.07v11.523a.648.648 0 01-.652.645.648.648 0 01-.652-.645V4.07a.785.785 0 00-.789-.78.785.785 0 00-.789.78v14.013a2.06 2.06 0 01-2.07 2.048 2.06 2.06 0 01-2.071-2.048V9.1a.762.762 0 00-.766-.758.762.762 0 00-.766.758v3.8a2.06 2.06 0 01-2.071 2.049A2.06 2.06 0 010 12.9v-1.378c0-.357.292-.646.652-.646.36 0 .653.29.653.646V12.9c0 .418.343.757.766.757s.766-.339.766-.757V9.099a2.06 2.06 0 012.07-2.048 2.06 2.06 0 012.071 2.048v8.984c0 .419.343.758.767.758.423 0 .766-.339.766-.758V4.07c0-1.143.937-2.07 2.093-2.07z"/></svg>',
  x:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>',
  typesafe:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3h18v4h-7v14h-4V7H3Zm0 8h4v10H3Zm14 4h4v6h-4Z"/></svg>',
  yours:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 5 4-5 4M12 16h7"/></svg>',
};

const COPY_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
const CHECK_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
const CHEVRON_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
const PREV_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>';
const NEXT_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
const ARROW_UP_RIGHT_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>';
const CLOSE_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';

const jevAnswers = JEV_DECISION.response.answers;
const jevJson = JSON.stringify(JEV_DECISION.response, null, 2);
const [jevMethod, jevUrl] = JEV_DECISION.endpoint.split(' ');
const jevEndpoint = new URL(jevUrl);

const pct = (share) => `${Math.round(share * 100)}%`;

const jevScoreRow = (key) => {
  const answer = jevAnswers[key];
  const bands = Object.entries(answer.legend).map(([band, name]) => ({ band, name, share: answer.probabilities[band] }));
  const landed = bands.reduce((best, band) => (band.share > best.share ? band : best));
  return {
    value: answer.score.toFixed(2),
    denom: `/ ${bands.length - 1}`,
    reading: landed.name,
    scale: bands.map(({ band, name }) => `${band} ${name}`).join(' · '),
    marks: bands.map(({ share }) => share),
  };
};

const jevPicks = Object.entries(jevAnswers.runtime_pick.probabilities)
  .map(([name, share]) => ({ name, share }))
  .sort((a, b) => b.share - a.share);
const [jevPick, jevRunnerUp] = jevPicks;

// a noul is the probability that a yes/no question is answered yes
const jevYes = jevAnswers.adopt_modern.noul;

// each row pairs the question asked with its answer, then the answer's meaning with its path in the response
const jevCardRows = [
  {
    key: 'adopt_modern',
    value: jevYes.toFixed(2),
    accent: true,
    split: true,
    reading: `${pct(jevYes)} yes`,
    scale: '0 Strong no · 1 Strong yes',
    marks: [jevYes, 1 - jevYes],
  },
  {
    key: 'runtime_pick',
    value: 'native-dates',
    split: true,
    reading: `${pct(jevPick.share)} vs ${jevRunnerUp.name} ${pct(jevRunnerUp.share)}`,
    scale: jevPicks.map(({ name, share }) => `${name} ${pct(share)}`).join(' · '),
    marks: [jevPick.share, 1 - jevPick.share],
  },
  { key: 'code_craft', ...jevScoreRow('code_craft') },
  { key: 'api_legibility', ...jevScoreRow('api_legibility') },
].map((row) => ({
  ...row,
  ...JEV_DECISION.questions[row.key],
  path: `${row.key}.${jevAnswers[row.key].type}`,
}));

const esc = (text) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const renderQuote = (text) => esc(text).replace(/`([^`]+)`/g, '<code>$1</code>');

// pack tall entries into solo columns and consecutive short entries into stacked pairs, ending on the prompt tile
const entries = [...AGENT_QUOTES, { id: 'your-agent', kind: 'prompt', size: 'short', source: 'yours' }];
const columns = [];
for (const entry of entries) {
  if (entry.size === 'tall') {
    columns.push({ type: 'tall', items: [entry] });
  }
  else {
    const prev = columns.at(-1);
    if (prev?.type === 'pair' && prev.items.length < 2) {
      prev.items.push(entry);
    }
    else {
      columns.push({ type: 'pair', items: [entry] });
    }
  }
}

// promote an unpaired trailing short card to a solo tall column so the rail never shows a half-empty slot
for (const col of columns) {
  if (col.type === 'pair' && col.items.length === 1) {
    col.type = 'tall';
  }
}

// duplicate the column set once for seamless looping while hiding the clone from screen readers and tab order
const sets = [false, true];
---
<div class="reads" data-reads>
  <div class="container">
    <div class="reads-head">
      <div class="reads-title">
        <p class="reads-eyebrow">{t(locale, 'home.reads.eyebrow')}</p>
        <h2>{t(locale, 'home.reads.title')}</h2>
      </div>
      <div class="reads-controls">
        <button class="reads-copy" type="button" data-reads-copy>
          <span class="reads-copy-icon" aria-hidden="true" set:html={COPY_ICON} />
          <span class="reads-copy-check" aria-hidden="true" set:html={CHECK_ICON} />
          <span data-reads-copy-label>{t(locale, 'home.reads.copy')}</span>
        </button>
        <button
          class="reads-inspect"
          type="button"
          aria-expanded="false"
          aria-controls="reads-prompt-drawer"
          data-reads-toggle
        >
          <span>{t(locale, 'home.reads.inspect')}</span>
          <Fragment set:html={CHEVRON_ICON} />
        </button>
        <div class="reads-nav">
          <button
            class="reads-step"
            type="button"
            aria-label={t(locale, 'home.reads.prev')}
            data-reads-prev
            set:html={PREV_ICON}
          />
          <button
            class="reads-step"
            type="button"
            aria-label={t(locale, 'home.reads.next')}
            data-reads-next
            set:html={NEXT_ICON}
          />
        </div>
      </div>
    </div>

    <div class="reads-drawer" id="reads-prompt-drawer" hidden>
      <div class="reads-drawer-head">
        <span class="reads-drawer-label">{t(locale, 'home.reads.promptLabel')}</span>
        <span class="reads-drawer-tools">Claude Code · Codex · Gemini CLI · Cursor</span>
        <button class="copy" type="button" data-copy="#agent-read-prompt" aria-label={t(locale, 'home.reads.copy')}></button>
      </div>
      <pre class="reads-drawer-body" id="agent-read-prompt" lang="en" dir="ltr" set:text={AGENT_PROMPT} />
    </div>
  </div>

  <div class="reads-rail" dir="ltr" data-reads-rail>
    <div class="reads-track" role="region" aria-label={t(locale, 'home.reads.list')} tabindex="0" data-reads-track>
      {sets.map((cloned) => (
        <div class="reads-set" data-reads-set aria-hidden={cloned ? 'true' : undefined}>
          {columns.map((col) => (
            <div class:list={['reads-col', col.type === 'tall' ? 'is-tall' : 'is-pair']}>
              {col.items.map((item) => (
                item.kind === 'prompt'
                  ? (
                    <article class:list={['read-card', col.type === 'tall' ? 'is-tall' : 'is-short', 'is-yours']}>
                      <p class="read-quote">{t(locale, 'home.reads.yours.copy')}</p>
                      <div class="read-yours-foot">
                        <p class="read-by">
                          <span class="read-mark is-yours" aria-hidden="true" set:html={SOURCE_MARK.yours} />
                          <strong>{t(locale, 'home.reads.yours.name')}</strong>
                        </p>
                        <button
                          class="reads-copy is-compact"
                          type="button"
                          tabindex={cloned ? -1 : undefined}
                          data-reads-copy
                        >
                          <span class="reads-copy-icon" aria-hidden="true" set:html={COPY_ICON} />
                          <span class="reads-copy-check" aria-hidden="true" set:html={CHECK_ICON} />
                          <span data-reads-copy-label>{t(locale, 'home.reads.copy')}</span>
                        </button>
                      </div>
                    </article>
                  )
                  : item.kind === 'jev'
                  ? (
                    <button
                      class:list={['read-card', col.type === 'tall' ? 'is-tall' : 'is-short', 'is-jev']}
                      type="button"
                      lang="en"
                      dir="ltr"
                      tabindex={cloned ? -1 : undefined}
                      aria-haspopup="dialog"
                      aria-controls="reads-jev-dialog"
                      data-jev-open
                    >
                      <span class="read-jev-head">
                        <span class="read-brand">
                          <span class="read-mark" aria-hidden="true" set:html={SOURCE_MARK[item.source]} />
                          <strong>{item.name}</strong>
                        </span>
                        <span class="jev-open-icon" aria-hidden="true" set:html={ARROW_UP_RIGHT_ICON} />
                      </span>

                      <span class="jev-ledger">
                        {jevCardRows.map((row) => (
                          <span class="jev-row">
                            <span class="jev-line">
                              <span class="jev-ask" title={row.prompt}>{row.label}</span>
                              <span class:list={['jev-val', row.accent && 'is-accent']}>
                                <b>{row.value}</b>{row.denom && <span class="jev-denom"> {row.denom}</span>}
                              </span>
                            </span>
                            <span class="jev-line is-sub">
                              <span class="jev-read" title={row.scale}>
                                <span class:list={['jev-marks', row.split && 'is-split', row.accent && 'is-accent']} aria-hidden="true">
                                  {row.marks.map((share) => <span style={`--share: ${share}`} />)}
                                </span>
                                <span>{row.reading}</span>
                              </span>
                              <span class="jev-path">{row.path}</span>
                            </span>
                          </span>
                        ))}
                      </span>
                    </button>
                  )
                  : item.size === 'tall'
                  ? (
                    <figure class="read-card is-tall" lang="en" dir="ltr">
                      <figcaption class="read-brand">
                        <span class="read-mark" aria-hidden="true" set:html={SOURCE_MARK[item.source]} />
                        <strong>{item.brand ?? item.name}</strong>
                      </figcaption>
                      <div class="read-foot">
                        <blockquote class="read-quote" set:html={renderQuote(item.quote)} />
                        {item.kind === 'human' && (
                          <p class="read-by">
                            <strong>{item.name}</strong>
                            {item.role && <span>{item.role}</span>}
                          </p>
                        )}
                      </div>
                    </figure>
                  )
                  : (
                    <figure class="read-card is-short" lang="en" dir="ltr">
                      <blockquote class="read-quote" set:html={renderQuote(item.quote)} />
                      <figcaption class="read-by">
                        <span class="read-mark is-quiet" aria-hidden="true" set:html={SOURCE_MARK[item.source]} />
                        <strong>{item.name}</strong>
                        {item.role && <span>{item.role}</span>}
                      </figcaption>
                    </figure>
                  )
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="container">
    <p class="reads-disclaimer">{t(locale, 'home.reads.disclaimer')}</p>
  </div>

  <dialog
    class="jev-dialog"
    id="reads-jev-dialog"
    aria-labelledby="reads-jev-title"
    lang="en"
    dir="ltr"
    data-jev-dialog
  >
    <div class="jev-panel">
      <div class="jev-head">
        <div class="jev-identity">
          <span class="read-mark" aria-hidden="true" set:html={SOURCE_MARK.typesafe} />
          <h3 id="reads-jev-title">TypeSafe Jev</h3>
          <span class="jev-model">{JEV_DECISION.model}</span>
        </div>
        <button class="icon-btn jev-close" type="button" aria-label="Close" data-jev-close set:html={CLOSE_ICON} />
      </div>

      <div class="code jev-code">
        <div class="code-head">
          <div role="tablist" aria-label="Decisions API payload" data-jev-tabs>
            <button
              class="code-tab"
              type="button"
              role="tab"
              id="jev-tab-json"
              aria-selected="true"
              aria-controls="jev-panel-json"
              data-jev-tab="json"
            >
              Response
            </button>
            <button
              class="code-tab"
              type="button"
              role="tab"
              id="jev-tab-reproduce"
              aria-selected="false"
              aria-controls="jev-panel-reproduce"
              tabindex="-1"
              data-jev-tab="reproduce"
            >
              Query
            </button>
          </div>
          <button
            class="reads-copy is-modal-copy"
            type="button"
            aria-label={t(locale, 'page.copyCode')}
            data-jev-copy
          >
            <span class="reads-copy-icon" aria-hidden="true" set:html={COPY_ICON} />
            <span class="reads-copy-check" aria-hidden="true" set:html={CHECK_ICON} />
            <span data-jev-copy-label>Copy</span>
          </button>
        </div>
        <div class="jev-panels">
          <pre id="jev-panel-json" role="tabpanel" aria-labelledby="jev-tab-json" data-hl data-jev-panel="json" set:text={jevJson} />
          <pre id="jev-panel-reproduce" role="tabpanel" aria-labelledby="jev-tab-reproduce" data-hl data-jev-panel="reproduce" hidden set:text={JEV_DECISION.reproduce} />
        </div>
      </div>

      <p class="jev-foot">
        <span>{jevMethod} <span class="jev-origin">{jevEndpoint.origin}</span>{jevEndpoint.pathname}</span>
        <span>{JEV_DECISION.package}</span>
      </p>
    </div>
  </dialog>
</div>
