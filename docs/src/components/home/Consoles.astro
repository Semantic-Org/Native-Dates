---
// one question at a time, asked of Date and of native-dates on Temporal. the reader picks a question
// from the four, both consoles answer it together, and then a line says why Date misses. the page
// ships the build's answers; the browser asks again itself (scripts/home/consoles-live.js)
import * as library from 'native-dates';

import { t } from '../../lib/i18n.js';
import { CASES, preview } from '../../scripts/home/consoles.js';

const locale = Astro.currentLocale;
const cases = CASES.map((c) => ({ ...c, dateOut: preview(c.date.run(), library), nativeOut: preview(c.native.run(library), library) }));
---
<div class="ask" data-consoles>
  <div class="ask-list" role="tablist" aria-orientation="vertical" aria-label={t(locale, 'home.consoles.pick')}>
    {cases.map((c, i) => (
      <button class="ask-tab" type="button" role="tab" id={`ask-tab-${c.id}`} aria-controls={`ask-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="console-number" aria-hidden="true">{i + 1}</span>
        <span set:html={t(locale, `home.consoles.${c.id}.ask`)} />
      </button>
    ))}
  </div>
  <div class="ask-answers swap">
    {cases.map((c, i) => (
      <div class="ask-panel" role="tabpanel" id={`ask-${c.id}`} aria-labelledby={`ask-tab-${c.id}`} data-case={c.id} hidden={i > 0}>
        <div class="ask-consoles">
          <div class="console is-date" data-name="Date">
            <p class="console-head"><b>Date</b> {t(locale, 'home.consoles.date.since')}</p>
            {c.date.lines.map((line) => <pre class="console-in" data-hl set:text={line} />)}
            <p class="console-out"><code data-date-out>{c.dateOut}</code> <span class="console-miss">{t(locale, `home.consoles.${c.id}.miss`)}</span></p>
          </div>
          <div class="console is-native" data-name="native-dates">
            <p class="console-head"><b>native-dates</b> {t(locale, 'home.consoles.native.on')}</p>
            {c.native.lines.map((line) => <pre class="console-in" data-hl set:text={line} />)}
            <p class="console-out"><code data-native-out>{c.nativeOut}</code></p>
          </div>
        </div>
        <p class="ask-why" set:html={t(locale, `home.consoles.${c.id}.why`)} />
      </div>
    ))}
  </div>
</div>
