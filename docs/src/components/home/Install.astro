---
// both install lines stay on screen so a reader who works through an agent never has to go looking for theirs
import { t } from '../../lib/i18n.js';

const { id, solo = false } = Astro.props;
const locale = Astro.currentLocale;
const INSTALL = 'npm i native-dates';
const INSTALL_WITH_AGENT = 'npx native-dates';
---
<div class:list={['install', { solo }]}>
  <div class="install-cmd">
    <span class="prompt" aria-hidden="true">$</span>
    <code id={`install-${id}`} data-shell>{INSTALL}</code>
    <button class="copy" type="button" data-copy={`#install-${id}`} aria-label={t(locale, 'home.install.copy')}></button>
  </div>
  <div class="install-agent">
    <p>{t(locale, 'home.install.agent')}</p>
    <div class="install-cmd">
      <span class="prompt" aria-hidden="true">$</span>
      <code id={`install-agent-${id}`} data-shell>{INSTALL_WITH_AGENT}</code>
      <button class="copy" type="button" data-copy={`#install-agent-${id}`} aria-label={t(locale, 'home.install.copyAgent')}></button>
    </div>
  </div>
</div>
