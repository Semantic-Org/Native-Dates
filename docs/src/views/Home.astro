---
// the homepage: the pitch, then one made thing per argument. a sentence that is also code, the
// primitives Temporal ships and the call for each, Date and Temporal asked the same questions, a year of one standup across two cities, the same dates on
// Temporal alone, a running app, and what it all weighs
import { getCollection } from 'astro:content';

import Bytes from '../components/home/Bytes.astro';
import Consoles from '../components/home/Consoles.astro';
import Primitives from '../components/home/Primitives.astro';
import Say from '../components/home/Say.astro';
import Verdict from '../components/home/Verdict.astro';
import Xray from '../components/home/Xray.astro';
import YearStrip from '../components/home/YearStrip.astro';
import Playground from '../components/Playground.astro';
import Base from '../layouts/Base.astro';
import { filesFor } from '../lib/examples.js';
import { draftStrings, languageMenu, languageSelect, languagesWith, localeOf, localePath, t } from '../lib/i18n.js';
import { ICON, MARK } from '../lib/icons.js';
import { formatSize, sizeOf } from '../lib/sizes.js';
import { REPO_URL, versionMenu } from '../lib/versions.js';
import '../styles/home.css';

const locale = Astro.currentLocale;
const to = (path) => localePath(path, locale);
// the core's size wherever the page's words quote it ({size}), measured like every other size here
const size = formatSize(await sizeOf('core')).replace(' ', '&nbsp;');
// the page's words are keys (t() here and in its components, ui() in its scripts) from
// content/strings.json; a language that has translated them is one the page is written in
const translatedIn = languagesWith('home.', { reviewed: true });
const writtenIn = languagesWith('home.');
const draft = writtenIn.includes(locale) && draftStrings(locale);
const tryEntry = (await getCollection('examples')).find((e) => e.id === 'meeting-planner');
const SECTIONS = [['nav.guides', '/guides/installation/'], ['nav.api', '/api/date-time/'], ['nav.examples', '/examples/'], ['nav.plugins', '/plugins/']];
const INSTALL = 'npm i native-dates';
---
<Base title="native-dates" description={t(locale, 'home.description')} writtenIn={writtenIn} translatedIn={translatedIn}>
  <header class="topbar">
    <div class="container topbar-inner">
      <button class="icon-btn menu-toggle" type="button" aria-label={t(locale, 'nav.open')} data-close-label={t(locale, 'home.nav.close')} aria-expanded="false" aria-controls="home-menu" data-menu-toggle set:html={ICON.menu} />
      <a class="wordmark" href={to('/')} aria-label={t(locale, 'nav.home')}><Fragment set:html={MARK} />native-dates</a>
      <nav class="topnav" aria-label={t(locale, 'home.nav.primary')}>
        {SECTIONS.map(([name, path]) => <a href={to(path)}>{t(locale, name)}</a>)}
      </nav>
      <div class="topbar-tools">
        <button class="search-trigger" type="button" aria-keyshortcuts="Meta+K Control+K"><Fragment set:html={ICON.search} /><span class="label">{t(locale, 'search.label')}</span><span class="keys" aria-hidden="true"><kbd>⌘</kbd><kbd>K</kbd></span></button>
        <Fragment set:html={versionMenu(Astro.site, locale) + languageMenu(Astro.url.pathname, locale)} />
        <a class="icon-btn" href={REPO_URL} aria-label={t(locale, 'nav.github')} set:html={ICON.github} />
        <button class="icon-btn" type="button" data-theme-toggle aria-label={t(locale, 'nav.theme')} set:html={ICON.theme} />
      </div>
    </div>
    {/* the sections, for screens too narrow for the topnav */}
    <nav class="home-menu" id="home-menu" aria-label={t(locale, 'nav.sections')} hidden>
      {SECTIONS.map(([name, path]) => <a href={to(path)}>{t(locale, name)}</a>)}
      <Fragment set:html={languageSelect(Astro.url.pathname, locale)} />
    </nav>
  </header>
  {/* a machine translation nobody has reviewed says so under the topbar, with the way to english */}
  {draft && <p class="archive-banner" lang={locale} dir={localeOf(locale).dir}>{t(locale, 'language.draft')} <a href="/" hreflang="en" lang="en" data-language-pick="en">{t(locale, 'language.readEnglish')}</a></p>}

  <main id="content">
    <section class="hero">
      <div class="container">
        <div class="hero-copy">
          <h1 set:html={t(locale, 'home.hero.title')} />
          <p class="lede" set:html={t(locale, 'home.hero.lede', { size })} />
          <div class="hero-side">
            <div class="install-cmd">
              <span class="prompt" aria-hidden="true">$</span>
              <code id="install-hero" data-shell>{INSTALL}</code>
              <button class="copy" type="button" data-copy="#install-hero" aria-label={t(locale, 'home.install.copy')}></button>
            </div>
            <div class="hero-actions">
              <a class="btn primary" href={to('/guides/installation/')}>{t(locale, 'home.hero.start')}</a>
              <a class="btn ghost" href={to('/api/date-time/')}>{t(locale, 'home.hero.api')}</a>
            </div>
          </div>
        </div>
        <Say />
      </div>
    </section>

    <section class="ribbon">
      <div class="container">
        <div class="ribbon-head">
          <h2>{t(locale, 'home.prims.title')}</h2>
          <p>{t(locale, 'home.prims.lede')}</p>
        </div>
        <Primitives />
      </div>
    </section>

    <section class="ribbon">
      <div class="container">
        <div class="ribbon-head">
          <Verdict />
          <p set:html={t(locale, 'home.consoles.lede')} />
        </div>
        <Consoles />
      </div>
    </section>

    <section class="ribbon">
      <div class="container">
        <YearStrip />
      </div>
    </section>

    <section class="ribbon">
      <div class="container">
        <div class="ribbon-head">
          <h2>{t(locale, 'home.xray.title')}</h2>
          <p>{t(locale, 'home.xray.lede')}</p>
        </div>
        <Xray />
      </div>
    </section>

    <section class="ribbon ribbon-try">
      <div class="container">
        <div class="ribbon-head">
          <h2>{t(locale, 'home.try.title')}</h2>
          <p>{t(locale, 'home.try.lede')}</p>
        </div>
        <Playground files={filesFor(tryEntry.id)} tabs={tryEntry.data.tabs} label={t(locale, 'home.try.label')} lineNumbers={false} />
        <a class="text-link" href={to('/examples/')}>{t(locale, 'home.try.link')}</a>
      </div>
    </section>

    <section class="ribbon" id="plugins">
      <Bytes />
    </section>

    <section class="closer">
      <div class="container closer-inner">
        <div class="closer-now">
          <h2 set:html={t(locale, 'home.closer.title')} />
          <p class="closer-clock"><code data-hl-done>now().text</code> <span data-now></span></p>
        </div>
        <div class="closer-actions">
          <div class="install-cmd solo">
            <span class="prompt" aria-hidden="true">$</span>
            <code id="install-closer" data-shell>{INSTALL}</code>
            <button class="copy" type="button" data-copy="#install-closer" aria-label={t(locale, 'home.install.copy')}></button>
          </div>
          <a class="btn primary" href={to('/guides/installation/')}>{t(locale, 'home.hero.start')}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a class="wordmark" href={to('/')}><Fragment set:html={MARK} />native-dates</a>
        <p>{t(locale, 'home.footer.license')}</p>
      </div>
      <nav class="footer-cols" aria-label={t(locale, 'home.footer.label')}>
        <div><h2>{t(locale, 'home.footer.docs')}</h2>{SECTIONS.map(([name, path]) => <a href={to(path)}>{t(locale, name)}</a>)}</div>
        <div><h2>{t(locale, 'home.footer.packages')}</h2><a href="https://www.npmjs.com/package/native-dates">native-dates</a><a href="https://www.npmjs.com/package/@native-dates/plugins">@native-dates/plugins</a><a href="https://www.npmjs.com/package/@native-dates/polyfill">@native-dates/polyfill</a></div>
        <div><h2>{t(locale, 'home.footer.project')}</h2><a href={REPO_URL}>{t(locale, 'nav.github')}</a><a href={`${REPO_URL}/releases`}>{t(locale, 'version.changelog')}</a></div>
      </nav>
    </div>
  </footer>

  <script>
    import { init } from '../scripts/site.js';
    import { mountBytes } from '../scripts/home/bytes.js';
    import { mountConsoles, mountQuestions } from '../scripts/home/consoles-live.js';
    import { mountPrimitives } from '../scripts/home/primitives.js';
    import { mountVerdict } from '../scripts/home/verdict.js';
    import { mountSay } from '../scripts/home/say.js';
    import { mountYear } from '../scripts/home/year.js';
    import { mountXray } from '../scripts/xray.js';

    init();
    document.querySelectorAll('[data-xray]').forEach(mountXray);
    document.querySelectorAll('[data-year]').forEach(mountYear);
    document.querySelectorAll('[data-bytes]').forEach(mountBytes);
    document.querySelectorAll('[data-consoles]').forEach(mountQuestions);
    document.querySelectorAll('[data-primitives]').forEach(mountPrimitives);
    document.querySelectorAll('[data-verdict]').forEach(mountVerdict);

    // the parts that compute dates run on the reader's own Temporal, read again for their day, zone
    // and locale. a browser that doesn't ship Temporal yet loads it first, as an app there would.
    // until then, and if none of it loads, the page reads with the build's answers
    (async () => {
      if (!globalThis.Temporal) {
        const { Temporal } = await import('temporal-polyfill');
        globalThis.Temporal = Temporal;
      }
      const library = await import('native-dates');
      document.querySelectorAll('[data-say]').forEach((root) => mountSay(root, library));
      document.querySelectorAll('[data-consoles]').forEach((root) => mountConsoles(root, library));
      // the closer tells the time, and tells it again as each minute turns
      const clock = document.querySelector('[data-now]');
      const tell = () => {
        clock.textContent = library.now().text;
        setTimeout(tell, 60_000 - (Date.now() % 60_000));
      };
      tell();
    })();

    // the menu on narrow screens: opens under the topbar, closes on a pick, a tap outside or Escape
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.getElementById('home-menu');
    // both labels come with the button, in the page's language
    const openLabel = toggle.getAttribute('aria-label');
    const setMenu = (open) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', open);
      toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel : openLabel);
    };
    toggle.addEventListener('click', () => setMenu(menu.hidden));
    menu.addEventListener('click', (e) => { if (e.target.closest('a')) setMenu(false); });
    document.addEventListener('pointerdown', (e) => {
      if (!menu.hidden && !menu.contains(e.target) && !toggle.contains(e.target)) setMenu(false);
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setMenu(false); toggle.focus(); }
    });
  </script>
</Base>
