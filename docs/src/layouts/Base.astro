---
import { DEFAULT_LOCALE, languageOffer, localeOf, localePath, scriptStrings, searchSuggested, t, unlocalized } from '../lib/i18n.js';
import { LATEST_ORIGIN } from '../lib/versions.js';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource/fragment-mono/400.css';
import '@fontsource/fragment-mono/400-italic.css';
import '../styles/tokens.css';
import sansLatin from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource/fragment-mono/files/fragment-mono-latin-400-normal.woff2?url';

// writtenIn includes draft translations for the language switcher. translatedIn is restricted to reviewed locales for canonical and hreflang tags.
const { title, description = t(DEFAULT_LOCALE, 'home.description'), share = true, writtenIn = [DEFAULT_LOCALE], translatedIn = [DEFAULT_LOCALE] } = Astro.props;
const locale = localeOf(Astro.currentLocale);
// escape < so localized UI strings cannot close the script tag
const strings = JSON.stringify({
  ...scriptStrings(locale.code, { home: unlocalized(Astro.url.pathname) === '/' }),
  $suggested: await searchSuggested(locale.code),
}).replace(/</g, '\\u003c');
// share cards are generated at build time from English routes until localized OG images exist
const path = unlocalized(Astro.url.pathname);
const image = new URL(`/og/${path.replace(/^\/|\/$/g, '') || 'index'}.png`, Astro.site);
const urlIn = (code) => new URL(localePath(path, code), Astro.site);
const canonical = urlIn(translatedIn.includes(locale.code) ? locale.code : DEFAULT_LOCALE);
const alternates = translatedIn.length > 1 ? translatedIn : [];
const offer = JSON.stringify(languageOffer(Astro.url.pathname, locale.code, writtenIn)).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={locale.code} dir={locale.dir}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {alternates.map((code) => <link rel="alternate" hreflang={code} href={urlIn(code)} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={urlIn(DEFAULT_LOCALE)} />}
  <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {/* block search indexing on non-production origins while keeping Open Graph tags intact */}
  {Astro.site?.origin !== LATEST_ORIGIN && <meta name="robots" content="noindex">}
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <link rel="canonical" href={canonical}>
  {share && <>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="native-dates">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
  </>}
  <script is:inline>
    // apply saved or system theme before first paint
    (() => {
      let t = null;
      try { t = localStorage.getItem('nd:theme'); } catch {}
      document.documentElement.dataset.theme = t || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    })();
  </script>
  <script is:inline type="application/json" id="language-offer" set:html={offer}></script>
  <script is:inline>
    // never auto-redirect on browser locale alone. Offer matching translations in a toast, and only redirect future visits if the reader explicitly opts in.
    (() => {
      const data = JSON.parse(document.getElementById('language-offer').textContent);
      const store = (area, key, value) => {
        try {
          if (value === undefined) { return area.getItem(key); }
          if (value === null) { area.removeItem(key); } else { area.setItem(key, value); }
        } catch {}
        return null;
      };
      const picked = store(sessionStorage, 'nd:language-picked');
      store(sessionStorage, 'nd:language-picked', null);
      const always = store(localStorage, 'nd:language');

      if (!picked && always && always !== data.page && data.paths[always]) {
        location.replace(data.paths[always] + location.search + location.hash);
        return;
      }
      if (picked && always && always !== data.page) { store(localStorage, 'nd:language', null); }

      const toast = (text, actions, { lang, dir } = {}) => {
        const el = document.createElement('div');
        el.className = 'language-toast';
        el.setAttribute('role', 'region');
        if (lang) { el.lang = lang; el.dir = dir; }
        const p = document.createElement('p');
        p.textContent = text;
        el.append(p, ...actions.map(([label, run, primary]) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = primary ? 'btn primary' : 'btn ghost';
          button.textContent = label;
          button.addEventListener('click', () => { el.remove(); run(); });
          return button;
        }));
        document.body.append(el);
      };
      const pick = (code) => store(sessionStorage, 'nd:language-picked', code);

      addEventListener('DOMContentLoaded', () => {
        document.addEventListener('click', (event) => {
          const link = event.target.closest?.('[data-language-pick]');
          if (link) { pick(link.dataset.languagePick); }
        });

        const asked = (store(localStorage, 'nd:language-asked') ?? '').split(' ');
        if (picked === data.page) {
          // choosing English dismisses future language prompts without setting a redirect
          if (data.page === data.english) { store(localStorage, 'nd:language-quiet', '1'); }
          else if (always !== data.page && !asked.includes(data.page)) {
            const answered = () => store(localStorage, 'nd:language-asked', [...asked, data.page].join(' ').trim());
            toast(data.remember.ask, [
              [data.remember.yes, () => { answered(); store(localStorage, 'nd:language', data.page); }, true],
              [data.remember.no, answered],
            ]);
          }
          return;
        }
        if (always || store(localStorage, 'nd:language-quiet')) { return; }
        const matches = (tag, code) => tag.toLowerCase() === code.toLowerCase() || tag.split('-')[0].toLowerCase() === code.split('-')[0].toLowerCase();
        for (const tag of navigator.languages ?? []) {
          if (matches(tag, data.page)) { return; }
          const o = data.others.find((candidate) => matches(tag, candidate.code));
          if (o) {
            toast(o.offer, [
              [o.go, () => { pick(o.code); location.assign(o.href + location.search + location.hash); }, true],
              [o.dismiss, () => store(localStorage, 'nd:language-quiet', '1')],
            ], { lang: o.code, dir: o.dir });
            return;
          }
        }
      });
    })();
  </script>
  <script is:inline type="application/json" id="ui-strings" set:html={strings}></script>
  <slot name="head" />
</head>
<body {...Astro.props.bodyAttrs}>
  <a class="visually-hidden" href="#content">{t(locale.code, 'nav.skip')}</a>
  <slot />
</body>
</html>
