---
// the docs frame every docs page shares: topbar, sidebar, the main column and on-this-page.
// a page passes what goes in main; `wide` drops on-this-page for index pages like /plugins/
import { getCollection } from 'astro:content';

import '../styles/docs.css';
import { languageSelect, localePath, t, titlesIn } from '../lib/i18n.js';
import { navFor } from '../lib/nav.js';
import DocsTopbar from '../components/DocsTopbar.astro';
import Base from './Base.astro';

const { title, description, currentId, toc = [], wide = false, extraIds = [], writtenIn, translatedIn } = Astro.props;
const locale = Astro.currentLocale;
const ids = [
  ...(await getCollection('docs')).map((e) => e.id),
  ...(await getCollection('examples')).map((e) => `examples/${e.id}`),
  'plugins', 'examples', ...extraIds,
];
const nav = navFor(ids, currentId, { code: locale, titles: await titlesIn(locale) });
const sectionKey = currentId.split('/')[0];
const section = nav.find((s) => s.key === sectionKey);
---
<Base title={title} description={description} writtenIn={writtenIn} translatedIn={translatedIn} bodyAttrs={{ 'data-section': sectionKey }}>
  <DocsTopbar nav={nav} sectionKey={sectionKey} />

  <div class:list={['docs-shell', { 'is-wide': wide }]}>
    <aside class="docs-sidebar" id="docs-sidebar" aria-label={section.label}>
      <div class="sidebar-scroll">
        <nav class="drawer-sections" aria-label={t(locale, 'nav.sections')}>
          {nav.map((s) => <a href={s.href} aria-current={s.key === sectionKey ? 'page' : undefined}>{s.label}</a>)}
        </nav>
        <Fragment set:html={languageSelect(Astro.url.pathname, locale)} />
        {section.groups.map((g) => (
          <div class="nav-group">
            <h2 class="nav-group-label">{g.label}</h2>
            <ul>
              {g.items.map((it) => (
                <li>
                  {it.href
                    ? <a class:list={['nav-link', { 'is-symbol': it.symbol }]} href={it.href} aria-current={it.current ? 'page' : undefined}>{it.title}</a>
                    : <span class:list={['nav-link', 'is-stub', { 'is-symbol': it.symbol }]} title={t(locale, 'nav.notWritten')}>{it.title}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </aside>
    <div class="drawer-scrim"></div>

    <div class="docs-main">
      {/* on screens too narrow for the on-this-page column: the same list behind a bar that keeps
          the reader's section in view */}
      {!wide && toc.length > 0 && (
        <nav class="toc-bar" aria-label={t(locale, 'toc.label')} data-toc-bar>
          <button class="toc-bar-button" type="button" aria-expanded="false" aria-controls="toc-sheet">
            <span class="toc-bar-label">{t(locale, 'toc.label')}</span>
            <span class="toc-bar-current" data-toc-current></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="toc-sheet" id="toc-sheet" hidden>
            <ul class="toc-list">
              {toc.map((h) => <li class={`toc-h${h.depth}`}><a href={`#${h.slug}`} class:list={{ 'is-symbol': h.symbol }}>{h.text}</a></li>)}
            </ul>
          </div>
        </nav>
      )}
      <slot />
      {/* the on-this-page rail rides beside the doc, not at the window's edge */}
      {!wide && toc.length > 0 && (
        <aside class="docs-toc" aria-label={t(locale, 'toc.label')}>
          <p class="toc-label">{t(locale, 'toc.label')}</p>
          <ul class="toc-list">
            {toc.map((h) => <li class={`toc-h${h.depth}`}><a href={`#${h.slug}`} class:list={{ 'is-symbol': h.symbol }}>{h.text}</a></li>)}
          </ul>
        </aside>
      )}
    </div>

  </div>

  <slot name="after" />
  <script>
    import { init } from '../scripts/site.js';
    import { mountDocs } from '../scripts/docs-client.js';
    init();
    mountDocs();
  </script>
</Base>
